#!/usr/bin/env bash
# Verify a built web distribution can be served from a subpath (GitHub Pages serves a fork at
# /<repository>/): index.html exists, every asset it names is relative and present, and the
# WebAssembly module is real.
# Usage: tests/web/check-dist DIST_DIR
set -u
dist=${1:?usage: check-dist DIST_DIR}
failures=0
fail() { printf 'FAIL: %s\n' "$1" >&2; failures=$((failures + 1)); }
pass() { printf 'ok: %s\n' "$1"; }

index="$dist/index.html"
if [[ -f $index ]]; then pass 'index.html exists'; else fail 'index.html exists'; exit 1; fi
mapfile -t refs < <(grep -oE '(src|href)="[^"]+"|from '"'"'[^'"'"']+'"'"'|import\(["'"'"'][^"'"'"']+' "$index" \
	| sed -E 's/^(src|href)="//; s/"$//; s/^from '"'"'//; s/'"'"'$//; s/^import\(["'"'"']//')
if ((${#refs[@]})); then pass 'index.html names assets'; else fail 'index.html names assets'; fi
saw_js=0
for ref in "${refs[@]}"; do
	case $ref in
		http://* | https://* | data:*) continue ;;
		/*) fail "asset path is absolute, so it breaks under a subpath: $ref" ;;
	esac
	path=${ref#./}
	path=${path%%[?#]*}
	[[ -f $dist/$path ]] || fail "missing asset: $ref"
	[[ $path != *.js ]] || saw_js=1
done
if ((saw_js)); then pass 'index.html loads JavaScript glue'; else fail 'index.html loads JavaScript glue'; fi
mapfile -t modules < <(find "$dist" -maxdepth 1 -name '*.wasm')
if ((${#modules[@]} == 1)); then pass 'one WebAssembly module'; else fail "one WebAssembly module (found ${#modules[@]})"; fi
for module in "${modules[@]}"; do
	if [[ $(head -c 4 "$module" | od -An -tx1 | tr -d ' \n') == 0061736d ]]; then
		pass "$(basename "$module") has the WebAssembly magic number"
	else
		fail "$(basename "$module") has the WebAssembly magic number"
	fi
done
# Self-hosted fonts: the manifest exists and every font and licence it names is served, and every
# font file is an sfnt (TrueType or OpenType) that egui can read, never WOFF.
manifest="$dist/fonts/manifest.json"
if [[ -f $manifest ]]; then pass 'fonts/manifest.json exists'; else fail 'fonts/manifest.json exists'; fi
if [[ -f $manifest ]]; then
	mapfile -t font_files < <(grep -oE '"file":"[^"]+"' "$manifest" | sed -E 's/^"file":"//; s/"$//')
	mapfile -t licences < <(grep -oE '"license":"[^"]+"' "$manifest" | sed -E 's/^"license":"//; s/"$//')
	families=$(grep -oE '"family":"[^"]+"' "$manifest" | wc -l)
	if ((${#font_files[@]} > 0)); then pass "the manifest lists ${#font_files[@]} font files"; else fail 'the manifest lists font files'; fi
	if ((families > 0 && ${#licences[@]} == families)); then pass "each of $families families names its licence"; else fail "each family names its licence ($families families, ${#licences[@]} licences)"; fi
	for file in "${font_files[@]}" "${licences[@]}"; do
		# The same rule as font_offer::safe_file: the app drops any other path, so its font would vanish.
		if [[ ! $file =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ || /$file/ == */./* || /$file/ == */../* ]]; then
			fail "font path the app would refuse: $file"
		fi
		[[ -s $dist/fonts/$file ]] || fail "missing font asset: fonts/$file"
	done
	bad=0
	for file in "${font_files[@]}"; do
		[[ -f $dist/fonts/$file ]] || continue
		case $(head -c 4 "$dist/fonts/$file" | od -An -tx1 | tr -d ' \n') in
			00010000 | 4f54544f) ;;
			*) fail "not a TrueType/OpenType font: fonts/$file"; bad=1 ;;
		esac
	done
	((bad)) || pass 'every served font is TrueType or OpenType'
fi
if ((failures)); then printf '%d web distribution check(s) failed\n' "$failures" >&2; exit 1; fi
